      "boundElements": null,
      "updated": 1792522188795,
      "link": null,
      "locked": false,
      "text": "Starting a request takes a moment of the core; waiting for it takes none. So one core\nruns as many workflows as there are requests in flight, and the host settles each promise.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Starting a request takes a moment of the core; waiting for it takes none. So one core\nruns as many workflows as there are requests in flight, and the host settles each promise.",
      "autoResize": true,
      "lineHeight": 1.25
    },
