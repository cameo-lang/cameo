# Getopt::Options: a class body declares its switches, and parse folds the
# command line into an instance. A block cannot write into its
# surroundings, so each switch's step takes the options so far and the
# argument, and returns the next options:
#
#   class Options < Getopt::Options
#     bool :verbose, default: false
#     string :name, default: "world"
#     on("--verbose", "-v") { |o, _| o.with(verbose: true) }
#     on("--name", "-n", arg: true) { |o, arg| o.with(name: arg) }
#   end
#   options, files = Options.parse(ARGV)
#
# GetoptLong reads the command line: the switch forms, an unknown or
# incomplete switch as its error, and "--" ending the switches.
module Getopt
  class Switch
    list :names, of: :string
    bool :arg, default: false
    bool :optional, default: false
    proc :step

    # The flag GetoptLong takes for this switch.
    def flag
      return GetoptLong::OPTIONAL_ARGUMENT if optional
      arg ? GetoptLong::REQUIRED_ARGUMENT : GetoptLong::NO_ARGUMENT
    end
  end

  class Options
    attribute :switches, default: []

    # on("--name", "-n", arg: true) { |options, arg| … } declares a switch
    # by its names, the first one canonical, and the step from the options
    # so far and the argument to the next options. arg: :optional takes an
    # argument when one is attached, and gives "" otherwise.
    def self.on(*names, arg: false, &step)
      switch = Switch.new(names: names, arg: arg == true, optional: arg == :optional, step: step)
      self.switches += [switch]
    end

    # parse reads the arguments, ARGV by default, and returns the options
    # and the operands. A GetoptLong::Error is raised as GetoptLong raises
    # it, and printed unless quiet.
    def self.parse(argv = ARGV, quiet: false)
      opts = GetoptLong.new(*switches.map { |s| s.names + [s.flag] }, args: argv)
      opts.quiet = quiet
      table = switches
      options = opts.reduce(new) do |o, (name, value)|
        table.find { |s| s.names.first == name }.step.call(o, value)
      end
      [options, opts.rest]
    end
  end
end
