# Ruby's abbrev library: the unambiguous abbreviations of a set of words.
# Every prefix of a word that no other word shares maps to the word, the
# word itself included, and a pattern, a Regexp or a String prefix, keeps
# only the abbreviations that match it. It follows abbrev 0.1.2.
module Abbrev
  VERSION = "0.1.2"

  def self.abbrev(words, pattern = nil)
    pattern = Regexp.new("\\A" + Regexp.escape(pattern)) if pattern.is_a?(String)
    unless pattern.nil? || pattern.is_a?(Regexp)
      raise TypeError, "the pattern is a String or a Regexp, not #{pattern.class}"
    end
    # Each prefix of each word, longest first, is seen once for the word
    # that owns it, twice when another word shares it, and no shorter
    # prefix of a word is looked at once one is shared three times.
    state = words.reduce({seen: Hash.new(0), table: {}}) do |st, word|
      next st if word.empty?
      word.size.downto(1).reduce(st.merge(stop: false)) do |s, length|
        abbreviation = word[0...length]
        next s if s[:stop] || pattern && !pattern.match?(abbreviation)
        count = s[:seen][abbreviation] + 1
        seen = s[:seen].merge(abbreviation => count)
        case count
        when 1 then s.merge(seen: seen, table: s[:table].merge(abbreviation => word))
        when 2 then s.merge(seen: seen, table: s[:table].except(abbreviation))
        else s.merge(seen: seen, stop: true)
        end
      end
    end
    words.reduce(state[:table]) do |table, word|
      next table if pattern && !pattern.match?(word)
      table.merge(word => word)
    end
  end

  def abbrev(words, pattern = nil) = Abbrev.abbrev(words, pattern)
end
