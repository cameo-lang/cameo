message Person {
  enum Role {
    ROLE_UNSPECIFIED = 0;
    ROLE_ADMIN = 1;
    ROLE_USER = 2;
  }
  reserved 2;
  reserved "nickname";
  optional string name = 1;
  optional Address address = 15944;
  repeated string emails = 52183;
  map<string, int64> scores = 52147;
  optional Role role = 9284;
}
package geo;
