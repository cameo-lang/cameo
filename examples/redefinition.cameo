# A class is a value bound to its name. The same body binds the same class;
# a different body reopens a copy of it, and instances of the old one keep
# the old one.
class Greeter
  string :name

  def initialize(name)
    self.name = name
  end

  def greet = "hi #{name}"
end

first = Greeter.new("cameo")

class Greeter
  string :name

  def initialize(name)
    self.name = name
  end

  def greet = "hi #{name}"
end

puts first.greet
puts first.class == Greeter

class Greeter
  string :name

  def initialize(name)
    self.name = name
  end

  def greet = "hello #{name}"
end

puts first.greet
puts Greeter.new("cameo").greet
puts first.class == Greeter
