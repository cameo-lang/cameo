# A String carries its encoding: UTF-8, ASCII-8BIT (binary) or US-ASCII. A
# binary string has bytes and no characters: it answers what reads,
# makes and compares bytes, and raises for what needs characters, where
# Ruby reads its bytes as ASCII. Combining strings takes the encoding
# they are compatible in.
b = b"héllo\xFF"
p b, b.class, b.encoding, b.length, b.size, b.bytesize, b[1], b[1, 2], b[-1], b.bytes.first(3)
p b.index("l"), b.include?("ll"), b.start_with?("h"), b.delete_suffix(b"\xFF"), b.getbyte(0)
%w[upcase downcase chars reverse strip to_i ord center split].each do |name|
  begin
    name == "center" ? b.center(12) : b.send(name)
  rescue Encoding::CompatibilityError => e
    puts e.message
  end
end
p "caf\xC3\xA9".b.force_encoding("UTF-8").upcase
p b == b"héllo\xFF", b == "héllo", "abc".b == "abc", { "abc" => 1 }["abc".b], { "é" => 1 }["é".b], "a".b.hash == "a".hash
p "a" + b"\xFF", ("a" + b"\xFF").encoding, (b"\xFF" + "a").encoding, ("a".b + "é").encoding
begin
  "é" + b"\xFF"
rescue Encoding::CompatibilityError => e
  p e.class
end
x = b"\xE9"
p "a#{x}".encoding, "#{x}".encoding, ["a".b, "b"].join.encoding
a = "US".force_encoding("US-ASCII")
p a, a.encoding, a.valid_encoding?, (a + "é").encoding, a.upcase.encoding
begin
  b"\xFF".force_encoding("US-ASCII")
rescue Encoding::InvalidByteSequenceError => e
  p e.message
end
p 65.chr, 65.chr.encoding, 233.chr, 233.chr.encoding, 233.chr(Encoding::UTF_8), 0x263a.chr("UTF-8")
p "héllo".encode("UTF-8"), "caf\xC3\xA9".b.force_encoding("UTF-8"), b"a\xFFb".encode("UTF-8", "UTF-8", invalid: :replace), "aé".encode("US-ASCII", undef: :replace), b"x\xE9".encode("UTF-8", undef: :replace, replace: "?")
begin; "é".encode("US-ASCII"); rescue Encoding::UndefinedConversionError => e; p e.message; end
begin; b"\xE9".encode("UTF-8"); rescue Encoding::UndefinedConversionError => e; p e.message; end
s = "ab".b
s += b"\xFF"
p s, s.encoding, s.size
c = "x".b
c += "y"
p c.encoding, [1, 2].pack("C*").encoding, [0x263a].pack("U").encoding, "é".b.bytes, "é".bytes.pack("C*").force_encoding("UTF-8")
p b"\xff\xfe".unpack("C*"), "abc".b.sub("b", "X"), b"a\xFFc".gsub(/\xFF/n, "!")
# Bytes read one at a time, and a symbol's encoding from its name.
p "hé".b.getbyte(1), "abc".getbyte(-1), "abc".getbyte(3)
p :foo.encoding, :"é".encoding, :foo.to_s.encoding
p "é".ord
begin
  b"\xC3".to_sym
rescue EncodingError => e
  p e.message
end
p :aBc.swapcase, :"äöü".capitalize, :"ÄÖÜ".downcase
p :abc.casecmp(:ABD), :abc.casecmp("abc"), :"Ä".casecmp?(:"ä"), "Ä".casecmp("ä"), "a".casecmp(1)
p :a < :b, [:c, :a, :b].max, :b.between?(:a, :c), Symbol.include?(Comparable), String.include?(Comparable)
