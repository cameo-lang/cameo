# Ruby's base64 library: the RFC 2045 form with its line breaks, the strict
# form, and the URL-safe one. Each line prints what Ruby 3.4 prints.
require "base64"

p Base64.encode64("hello world, this is a longer string to wrap over sixty characters, right?")
p Base64.strict_encode64("hi"), Base64.strict_encode64(""), Base64.encode64("x").encoding
p Base64.urlsafe_encode64("\xff\xfe".b), Base64.urlsafe_encode64("\xff\xfe".b, padding: false)

# decode64 skips what is not base64; the strict and URL-safe forms refuse it.
p Base64.decode64("aGk="), Base64.decode64("aGk"), Base64.decode64("a\nGk=\n"), Base64.decode64("aGk=").encoding
p Base64.urlsafe_decode64("__4"), Base64.urlsafe_decode64("__4=")
["aGk", "a Gk="].each do |s|
  Base64.strict_decode64(s)
rescue ArgumentError => e
  puts "#{s.inspect}: #{e.message}"
end
begin
  Base64.urlsafe_decode64("aGk!")
rescue ArgumentError => e
  puts e.message
end
