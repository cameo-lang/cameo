p h.delete(:zz)
p h[:missing]
p h.to_a
p h.update(c: 3).to_a
p h.shift
p h.to_a
p h.select! { |k, v| v > 2 }.to_a
p h.select! { true }
p h[:nope]
p h.merge!(d: 4).to_a
