# A call that changes its receiver in Ruby -- <<, push, pop, delete, a
# bang method -- rebinds the local it is called on to the changed copy, as
# h[k] = v does. Its value is Ruby's: the receiver, the removed element,
# or nil from a bang method that changed nothing.
a = [1, 2]
a << 3 << 4
p a
p a.push(5, 6)
p a.pop
p a.pop(2)
p a.shift
p a.unshift(0)
p a.insert(1, :x)
p a.insert(-1, :y)
p a.concat([7], [8])
p a.delete(:x)
p a.delete(:none)
p a.delete_at(0)
p a.delete_at(99)
p a
x = [3, 1, 2, 2, nil]
p x.compact!
p x.compact!
p x.uniq!
p x.sort!
p x.map! { _1 * 2 }
p x.select! { _1 > 2 }
p x.select! { true }
p x.reject! { _1 > 5 }
p x
x.clear
p x
p x.replace([9])
p(x.delete_if { _1 > 5 })
p x.keep_if { true }
s = "ab"
s << "c" << 100
p s
p s.concat("e", "f")
p s.prepend(">")
p s.insert(1, "_")
p s.upcase!
p s.upcase!
p s
p s.reverse!
p s.succ!
