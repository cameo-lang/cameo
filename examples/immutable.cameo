# Collections never change: every operation returns a new value.
list = [1, 2, 3]
longer = list.append(4, 5)
puts list.inspect
puts longer.inspect
puts list.prepend(0).inspect
puts longer.without(2, 4).inspect
puts longer.without_at(0, -1).inspect
puts list.each_with_object([]) { |n, acc| acc.prepend(n) }.inspect

scores = {ann: 1, bob: 2}
more = scores.put(:cid, 3)
puts scores.size
puts more.size
puts more.without(:ann).keys.inspect
puts scores.merge({bob: 20}).values.inspect
puts scores.values.inspect
puts scores.each_with_object({}) { |(k, v), acc| acc.put(v, k) }.keys.inspect

# A call that changes its receiver in Ruby, such as Set#add or Array#<<,
# rebinds the local it is called on; another variable keeps the old value.
s = [1, 2].to_set
before = s
s.add(3)
puts before.size
puts s.size
puts s.without(1).to_a.inspect
puts before.to_a.inspect

text = "abc"
louder = text.upcase
puts text
puts louder

# Another variable keeps the value it had when the local was rebound.
list = [1]
other = list
list << 2
puts other.inspect
puts list.inspect
