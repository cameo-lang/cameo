# A class can describe itself as a protobuf message. A field's number is
# derived from its name, or given by number:, from 1 to 4096.
class Address
  string :street, :city
  int :zip

  def initialize(street, city, zip)
    self.street = street
    self.city = city
    self.zip = zip
  end
end

class Person
  string :name, number: 1
  reserved 2, :nickname
  ref :address, Address
  list :emails, of: :string
  map :scores, key: :string, value: :int
  enum :role, values: [:admin, :user]

  def initialize(name, address, emails: [], scores: {}, role: :user)
    self.name = name
    self.address = address
    self.emails = emails
    self.scores = scores
    self.role = role
  end
end

puts Person.proto

module Geo
  class Point
    int :x, :y
  end
end

puts Geo::Point.proto.lines.first
