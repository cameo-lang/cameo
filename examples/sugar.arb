# Syntax amber rewrites into what it has: argument forwarding, anonymous
# parameters, a top-level def self.x, for loops, alias, class A::B, and
# freeze and compare_by_identity, which change nothing.
def named(*a, **k, &b) = [a, k.to_a, b ? b.call : nil]
def fw(...) = named(...)
def fw2(x, ...) = named(x, ...)
def anon(*, **, &) = named(*, **, &)
def anon_rest(*) = named(*)
def anon_kw(**) = named(**)
p fw(1, 2, k: 3) { :blk }, fw2(0, 1, z: 2), anon(1, a: 2) { :b }, anon_rest(4, 5), anon_kw(q: 1), fw
def self.top_single(x) = x * 2
p top_single(21)
add = :+.to_proc
p add.call(1, 2), [1, 2].map(&:succ), :upcase.to_proc.call("a")
for i in 1..3
  last = i
end
p i
for a, b in [[1, 2], [3, 4]]
end
p [a, b]
r = for x in [7, 8] do end
p r
module Outer; end
class Outer::Inner
  def hi = "inner"
end
p Outer::Inner.new.hi, Outer::Inner.name
def orig = "orig"
alias copy orig
p copy
class K
  def a = 1
  alias b a
end
p K.new.b
s = "x".freeze
p s.frozen?, [1].freeze, {a: 1}.compare_by_identity[:a], Set[1].compare_by_identity.include?(1)
