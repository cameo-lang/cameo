# Math, Numeric#step and Range#bsearch.
p Math.sqrt(16), Math.cbrt(27), Math::PI, Math::E, Math.hypot(3, 4), Math.log(8, 2), Math.log2(8), Math.log10(1000)
p Math.atan2(1, 1), Math.exp(0), Math.sin(0), Math.cos(0)
begin
  Math.sqrt(-1)
rescue Math::DomainError => e
  puts "#{e.class}: #{e.message}"
end

# A float step computes each value from the start, so no error accumulates.
steps = [*0.0.step(1.0, 0.0001)]
p steps.size, steps.last, 1.0.step(2.0, 0.25).to_a, 1.step(2, 0.5).to_a, 10.step(1, -4).to_a, 0.1.step(0.3, 0.1).to_a

# bsearch finds the smallest value a block is true for, or one it returns
# 0 for; an endless or beginless range is probed outwards from its end.
p (1..10000).bsearch { |x| x >= 5000 }, (1..10).bsearch { |x| x > 20 }, (0..4).bsearch { |x| 2 <=> x }
p (1..).bsearch { |x| x >= 10000000000 }, (..0).bsearch { |x| x >= -100 }
p (0.0..100.0).bsearch { |x| x >= 2.5 }, (0.0..Float::INFINITY).bsearch { |x| Math.log(x) >= 0 }

# Gamma and its logarithm, exact on small integers. Elsewhere Go's
# functions may differ from C's in the last digit.
p Math.gamma(5), Math.gamma(0.5).round(12), Math.gamma(-0.0), Math.lgamma(6.0).first.round(12), Math.lgamma(-0.5)
begin
  Math.gamma(-1)
rescue Math::DomainError => e
  puts e.message
end

# Integer and Float helpers.
p 12.gcdlcm(18), -5.remainder(3), 5.remainder(-3.0), 5.5.remainder(2)
p 1.0.next_float - 1.0 == Float::EPSILON, 1.0.prev_float < 1.0, (-0.0).arg, 2.0.arg, -3.arg

# Ranges that share a value.
p (0..2).overlap?(2..4), (0...2).overlap?(2..4), (..0).overlap?(0..), ("a".."c").overlap?("d".."f")

# Float#round to a number of digits, with a half: mode, checked against
# the float itself so that the error in x * 10**n does not move it.
p 2.5.round(half: :even), 2.5.round(half: :down), -2.5.round(half: :up), 5.55.round(1, half: :down)
p 767573.187585.round(5, half: :even), 0.12345678901234567.round(16), 42.0.round(308)
p 2.5e20.round(-20), 25.round(-1, half: :even), -25.round(-1, half: :down)
begin
  2.5.round(half: :sideways)
rescue ArgumentError => e
  puts e.message
end

# Float#divmod returns an Integer quotient; a zero divisor raises.
p 3.5.divmod(2), -7.0.divmod(2), 0.59.divmod(7.761021455128987e-11).first
begin
  1.0 % 0
rescue ZeroDivisionError => e
  puts e.message
end
begin
  Float::NAN.divmod(1)
rescue FloatDomainError => e
  puts e.message
end

# Float powers are correctly rounded, and -0.0 is eql? to 0.0.
p 10.0**308 == (10**308).to_f, 1.1**10, -0.0.eql?(0.0)
p Float::DIG, Float::MANT_DIG, Float::MAX_EXP, Float::MIN_10_EXP, Float::RADIX
p 1.0.coerce("2.5"), 1.coerce("2"), 0b1010.allbits?(0b1000), 0b1010.anybits?(0b0101), 0b1010.nobits?(0b0101)
begin
  1.upto("A") { |i| p i }
rescue ArgumentError => e
  puts e.message
end
begin
  1.clone(freeze: false)
rescue ArgumentError => e
  puts e.message
end

# Without a block, step returns an arithmetic sequence, which knows its
# size and last element without counting.
p 1.step(10, 3), (1...10).step(4), (1..10) % 3, 1.0.step(2.0, 0.5)
p 1.step(10, 3).size, (1...10).step(4).last(2), 1.0.step(2.0, 0.3).last, 1.step(Float::INFINITY).size, (1..).step(5).first(3)
p 1.step(10).begin, 1.step(10).end, 1.step(10, 3).step, (1...10).step.exclude_end?, (1..10).step(100) == 1.step(10, 100)
p (1.0..2.0).step(0.5).to_a, (10..1).step(-3).to_a, (1..10).step(-1).to_a, [*1.step(3)]

# Range#reverse_each and each without a block are enumerators; min(n) and
# max(n) of an Integer range count from its ends.
p (1..3).reverse_each, (1..3).reverse_each.size, (..5).reverse_each.first(3), (1..3.3).reverse_each.to_a, ("a".."c").reverse_each.size
p (1..3).each, (1..3).each.size, (0...2**64).min(2), (0...2**20).max(2), (0..Float::INFINITY).first(3), (1..3.5).size
begin
  (1..).reverse_each.first(1)
rescue TypeError => e
  puts e.message
end
# An arithmetic sequence of Integers equals the same one of Floats.
p 1.step(3) == 1.0.step(3.0), (1..3).step(1) == 1.0.step(3.0, 1), 1.step(3) == 1.step(4)
