# Random numbers: Ruby's Mersenne Twister, so a seeded script prints what
# Ruby prints. A Random is a handle on a generator, as a file handle is on a
# file: each draw advances it, for every holder of the handle.
r = Random.new(42)
p r.rand, r.rand(100), r.rand(1..6), r.rand(2.5), r.rand(1.0...2.0)
p r.bytes(4).bytes, r.seed

same = r
p same.rand(1000), r.rand(1000)
dice = { d6: Random.new(7) }
p (1..10).map { dice[:d6].rand(1..6) }
p Random.new(7) == Random.new(7), Random.new(7) == dice[:d6]

# Kernel#rand, Array#shuffle and #sample draw from one generator, which
# srand seeds and returns the previous seed of.
srand(1234)
p rand, rand(10), rand(1..6), rand(-3), rand(1.5..2.5), rand(1...1)
deck = (1..52).to_a
p deck.shuffle.first(5), deck.sample, deck.sample(5)
p deck.shuffle(random: Random.new(5)).first(5), deck.sample(3, random: Random.new(5))
p srand(99)
p Random.rand(6), Random.seed

begin
  r.rand(-1)
rescue ArgumentError => e
  puts e.message
end
begin
  deck.sample(-1)
rescue ArgumentError => e
  puts e.message
end
