# A frankie app: a value each verb adds a route to, with its specs, and
# serve at the end. The script is run by cameo, compiled or not:
#
#   cameo examples/frankie/01_hello.cameo
#   curl localhost:4567/hi/sinatra
require "frankie"

app = Frankie.app

app = app.get("/") do
  "Hello from frankie!"
end

app = app.get("/hi/:name") do |req|
  "hi #{req.params["name"]}"
end

app = app.post("/echo") do |req|
  req.body
end

require "minispec"

describe "GET /" do
  it "greets" do
    res = app.request("GET", "/")
    assert_equal 200, res.status
    assert_equal "Hello from frankie!", res.body
    assert_equal "text/html;charset=utf-8", res.headers["Content-Type"]
  end
end

describe "GET /hi/:name" do
  it "captures the name" do
    assert_equal "hi sinatra", app.request("GET", "/hi/sinatra").body
  end

  it "needs the name" do
    assert_equal 404, app.request("GET", "/hi").status
    assert_equal "Not Found", app.request("GET", "/hi").body
  end
end

describe "POST /echo" do
  it "returns the body" do
    assert_equal "ring-a-ding", app.request("POST", "/echo", body: "ring-a-ding").body
  end

  it "takes no GET" do
    assert_equal 404, app.request("GET", "/echo").status
  end
end

app.serve
