# What a route returns: a String is the body with status 200, an Integer
# a status with an empty body, [status, body] and [status, headers, body]
# as in Sinatra. A route's params are its path captures and the query
# string, as Strings; the request's headers are in its Rack env, which
# user_agent and get_header read.
require "frankie"

app = Frankie.app

app = app.get("/users/:id") do |req|
  id = req.params["id"].to_i
  if id > 100
    [404, "no user #{id}"]
  else
    [200, {"Content-Type" => "text/plain", "X-User" => id.to_s}, "user #{id}"]
  end
end

app = app.get("/search") do |req|
  "#{req.params["q"]} in #{req.params.fetch("scope", "everything")}"
end

app = app.delete("/users/:id") do
  204
end

app = app.get("/agent") do |req|
  req.user_agent || "unknown"
end

require "minispec"
browser = Rack::MockRequest.new(app)

describe "GET /users/:id" do
  it "sets the status, the headers and the body" do
    res = browser.get("/users/7")
    assert_equal 200, res.status
    assert_equal "text/plain", res.content_type
    assert_equal "7", res["X-User"]
    assert_equal "user 7", res.body
  end

  it "sets the status and the body" do
    res = browser.get("/users/101")
    assert_equal [404, "no user 101"], [res.status, res.body]
    assert_equal "text/html;charset=utf-8", res.content_type
  end
end

describe "GET /search" do
  it "reads the query string" do
    assert_equal "ruby in everything", browser.get("/search", params: {"q" => "ruby"}).body
    assert_equal "ruby in gems", browser.get("/search?q=ruby&scope=gems").body
  end
end

describe "DELETE /users/:id" do
  it "returns a status alone" do
    res = browser.delete("/users/7")
    assert_equal 204, res.status
    assert_empty res.body
  end
end

describe "GET /agent" do
  it "reads a header" do
    assert_equal "curl", browser.get("/agent", "HTTP_USER_AGENT" => "curl").body
    assert_equal "unknown", browser.get("/agent").body
  end
end

app.serve
