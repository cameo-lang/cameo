class TooBig < StandardError; end

def check(n)
  raise TooBig, "#{n} is too big" if n > 10
  n
end

begin
  puts check(3)
  puts check(30)
rescue TooBig => e
  puts "caught: #{e.message}"
ensure
  puts "done"
end

attempts = 0
begin
  attempts += 1
  raise "flaky" if attempts < 3
  puts "ok after #{attempts}"
rescue RuntimeError
  retry
end

# Ruby's exception classes, under the superclasses Ruby gives them.
p [NotImplementedError, SyntaxError, KeyError, StopIteration, ClosedQueueError, UncaughtThrowError, EOFError, Interrupt].map(&:superclass)
p [SystemExit, NoMemoryError, SecurityError, SignalException, SystemStackError].map(&:superclass)
p [IOError, FiberError, ThreadError, SystemCallError].map(&:superclass)
caught = begin
  begin
    raise NotImplementedError, "later"
  rescue => e
    "a bare rescue"
  end
rescue NotImplementedError => e
  "rescue NotImplementedError: #{e.message}"
end
puts caught
begin
  {a: 1}.fetch(:b)
rescue IndexError => e
  puts "an IndexError: #{e.class}"
end

# A NameError names what was missing and where, a NoMethodError the
# arguments too, and a KeyError the key and the hash.
begin
  undefined_name
rescue NameError => e
  p e, e.name, e.receiver
end
begin
  undefined_call()
rescue NameError => e
  p e, e.name
end
begin
  1.foo(2, 3)
rescue NoMethodError => e
  p e, e.name, e.receiver, e.args
end
begin
  Comparable::Nope
rescue NameError => e
  p e, e.name, e.receiver
end
begin
  {a: 1}.fetch(:b)
rescue KeyError => e
  p e, e.key, e.receiver
end
made = NameError.new("msg", :name, receiver: 5)
p made.name, made.receiver, NameError.new.message
begin
  NameError.new("msg").receiver
rescue ArgumentError => e
  p e
end
p NoMethodError.new("m", :n, [1]).args, KeyError.new("m", receiver: 1, key: 2).key
begin
  begin
    undefined_name
  rescue NameError => e
    raise e, "again"
  end
rescue NameError => e
  p e, e.name
end

# exit and abort raise SystemExit, which a rescue of it may catch and a
# bare rescue does not.
p SystemExit.new, SystemExit.new(1).message, SystemExit.new(true).status, SystemExit.new(false).status
stopped = SystemExit.new(10, "message")
p stopped.status, stopped.message, stopped.success?, SystemExit.new.success?
begin
  exit 3
rescue SystemExit => e
  p e, e.status, e.success?
end
begin
  exit
rescue SystemExit => e
  p e.status, e.success?
end
begin
  begin
    exit(false)
  rescue => e
    p :not_here
  end
rescue SystemExit => e
  p e.status
end
