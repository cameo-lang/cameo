# cameo values never change, and no call changes or rebinds its receiver.
# This is where cameo deviates from Ruby on purpose:
#
# - A call of one of Ruby's mutators -- <<, push, pop, delete, store, add
#   -- on a value of the kind it changes raises a CameoError that names
#   the non-mutating form. `cameo --ignore-mutation-errors` makes the call
#   return Ruby's result instead, with the receiver left as it was.
# - A bang method of Ruby's core is refused before the script runs:
#   `x.compact!` is "This is not supported, use x = x.compact instead".
# - force_encoding returns the string relabelled and leaves the receiver;
#   a call whose value is dropped raises, since it would do nothing.
#
# Assignment to an element or a field makes a copy and rebinds the local.
def try
  yield
rescue CameoError => e
  puts e.message
end

a = [1, 2]
b = a
try { a << 3 }
try { a.push(3) }
try { a.pop }
try { a.delete(1) }
p a, b
a = a + [3]
p a, b, a.last, a.take(2), a.without(1)
a[0] = 0
p a, b

s = "ab"
try { s << "c" }
try { s.prepend(">") }
try { s.setbyte(0, 65) }
s = s + "c"
p s

h = {a: 1}
try { h.store(:b, 2) }
try { h.delete(:a) }
try { h.update(b: 2) }
h[:b] = 2
p h, h.put(:c, 3), h.without(:a), h.merge(d: 4), h

st = Set[1, 2]
try { st << 3 }
try { st.add(3) }
try { st.merge([3]) }
p st | [3], st - [1], st

bytes = "caf\xC3\xA9".b
text = bytes.force_encoding("UTF-8")
p text, text.encoding, bytes.encoding
try do
  bytes.force_encoding("UTF-8")
  nil
end

# The same names on a value they do not change are ordinary calls:
# Integer#<< shifts, and a class's own push is its own method.
class Stack
  list :items, of: :int
  def push(x) = with(items: items + [x])
end
n = 1
p n << 3, n
stack = Stack.new(items: [])
p stack.push(1).items, stack.items

x = [3, nil, 1, 3]
x = x.compact.uniq.sort
p x
