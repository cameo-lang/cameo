# Object includes Kernel, whose functions are called on it too.
Kernel.puts Kernel.format("%05d", 3)
p Object.ancestors.take(2), 1.is_a?(Kernel), Kernel.class
p Object.include?(Kernel), Integer.include?(Comparable), Comparable.include?(Comparable)
begin
  Integer.include?(String)
rescue TypeError => e
  p e
end

# Numeric is the superclass of Integer and Float, and BasicObject the root
# above Object.
p Integer.ancestors, Float.superclass, Object.superclass, BasicObject.superclass
p 1.is_a?(Numeric), 2.5.is_a?(Numeric), "1".is_a?(Numeric), nil.is_a?(BasicObject)
[3, 0.5, "3"].each do |x|
  case x
  when Numeric then puts "#{x.inspect} is a number"
  else puts "#{x.inspect} is not"
  end
end
